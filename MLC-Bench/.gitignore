# Build outputs (regenerated by mlc_llm package / Gradle)
# /dist/ is tracked via Git LFS for reproducibility
/build/
/app/build/
.cxx/

# Gradle
.gradle/

# Android Studio / IDE
.idea/
*.iml

# Local machine-specific config (SDK path etc.)
local.properties

# Python
__pycache__/
*.pyc

# Signing / keys (none should live in this repo, safety net)
*.jks
*.keystore

# APKs (built artifacts, not source)
*.apk
*.aab

# OS cruft
.DS_Store
Thumbs.db
