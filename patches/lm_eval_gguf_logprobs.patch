+    def _tokenize(self, text, retries=3, delay=5):
+        for _ in range(retries):
+            try:
+                response = requests.post(
+                    f"{self.base_url}/tokenize", json={"content": text}
+                )
+                response.raise_for_status()
+                return response.json()["tokens"]
+            except RequestException as e:
+                logger.error(f"RequestException: {e}")
+                time.sleep(delay)
+        raise RuntimeError(f"Failed to tokenize after {retries} retries.")
+
+    def _next_token_candidates(self, prompt_tokens, retries=3, delay=5):
+        for _ in range(retries):
+            try:
+                response = requests.post(
+                    f"{self.base_url}/completion",
+                    json={
+                        "prompt": prompt_tokens,
+                        "n_predict": 1,
+                        "n_probs": NUM_CANDIDATES,
+                        "temperature": self.temperature,
+                    },
+                )
+                response.raise_for_status()
+                data = response.json()
+                # llama-server omits this key entirely when it generates zero
+                # tokens for the request (probs_output empty server-side) --
+                # treat that the same as "continuation token wasn't among the
+                # candidates" rather than crashing.
+                completions = data.get("completion_probabilities")
+                if not completions:
+                    return []
+                return completions[0]["top_logprobs"]
+            except RequestException as e:
+                logger.error(f"RequestException: {e}")
+                time.sleep(delay)
+        raise RuntimeError(f"Failed to score next token after {retries} retries.")
+
+    def _score_continuation(self, context, continuation):
+        context_tokens = self._tokenize(context)
+        continuation_tokens = self._tokenize(continuation)
+        if not continuation_tokens:
+            return 0.0, True
+
+        prompt_tokens = list(context_tokens)
+        continuation_logprob = 0.0
+        is_greedy = True
+        for tok_id in continuation_tokens:
+            candidates = self._next_token_candidates(prompt_tokens)
+            match = next((c for c in candidates if c["id"] == tok_id), None)
+            continuation_logprob += match["logprob"] if match else FALLBACK_LOGPROB
+            if not candidates or candidates[0]["id"] != tok_id:
+                is_greedy = False
+            prompt_tokens.append(tok_id)
+
+        return continuation_logprob, is_greedy
